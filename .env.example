# Deployer private key (with 0x prefix)
PRIVATE_KEY=0x_your_private_key_here

# Etherscan V2 key - covers BscScan (testnet), Basescan, Arbiscan, etc.
# Get free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_v2_key_here

# Optional: existing savings token. Empty -> MockERC20 auto-deployed on BNB testnet
TOKEN_ADDRESS=
# Optional: custom BNB testnet RPC
BNB_TESTNET_RPC=

# Deployed Kibo contract address (fill after deploy)
NEXT_PUBLIC_KIBO_ADDRESS=      # Kibo address printed by deploy
NEXT_PUBLIC_TOKEN_ADDRESS=     # token address printed by deploy
